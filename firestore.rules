rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profiles are private to the user
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Reports can be viewed publicly (for sharing)
    // but only the backend server can create or modify them
    match /reports/{reportId} {
      allow read: if true;
      allow write: if false;
    }
    
  }
}
